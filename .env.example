# Postgres connection string. Neon, Supabase, or any Postgres 14+.
# Deployed on serverless, use the POOLED string here: every function instance
# opens its own pool and a direct connection limit runs out fast.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Only needed when DATABASE_URL points at a transaction pooler. Migrations
# cannot run through one, so the Prisma CLI uses this direct connection
# instead. Leave it unset locally: DATABASE_URL does both jobs.
# DIRECT_URL="postgresql://user:password@direct-host:5432/dbname?sslmode=require"

# Session signing key. Generate with: npx auth secret
AUTH_SECRET=""

# Canonical URL of the deployment. http://localhost:3000 in development.
AUTH_URL="http://localhost:3000"
